<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_markket_user" model="res.groups">
        <field name="name">Markket User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_markket_manager" model="res.groups">
        <field name="name">Markket Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_markket_user'))]"/>
    </record>

    <record id="markket_store_rule_user_own" model="ir.rule">
        <field name="name">Markket Store: own records</field>
        <field name="model_id" ref="model_markket_store"/>
        <field name="domain_force">[('owner_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_markket_user'))]"/>
    </record>

    <record id="markket_store_rule_manager_all" model="ir.rule">
        <field name="name">Markket Store: manager all records</field>
        <field name="model_id" ref="model_markket_store"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_markket_manager'))]"/>
    </record>

    <record id="markket_api_key_rule_user_own" model="ir.rule">
        <field name="name">Markket API Key: own records</field>
        <field name="model_id" ref="model_markket_api_key"/>
        <field name="domain_force">[('owner_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_markket_user'))]"/>
    </record>

    <record id="markket_api_key_rule_manager_all" model="ir.rule">
        <field name="name">Markket API Key: manager all records</field>
        <field name="model_id" ref="model_markket_api_key"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_markket_manager'))]"/>
    </record>

    <record id="markket_store_url_rule_user_own" model="ir.rule">
        <field name="name">Markket Store URL: own records</field>
        <field name="model_id" ref="model_markket_store_url"/>
        <field name="domain_force">[('store_id.owner_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_markket_user'))]"/>
    </record>

    <record id="markket_store_url_rule_manager_all" model="ir.rule">
        <field name="name">Markket Store URL: manager all records</field>
        <field name="model_id" ref="model_markket_store_url"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_markket_manager'))]"/>
    </record>
</odoo>
