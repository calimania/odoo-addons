<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_markket_store_url_list" model="ir.ui.view">
        <field name="name">markket.store.url.list</field>
        <field name="model">markket.store.url</field>
        <field name="arch" type="xml">
            <list>
                <field name="store_id"/>
                <field name="sequence"/>
                <field name="label"/>
                <field name="url"/>
                <field name="markket_url_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_markket_store_url_form" model="ir.ui.view">
        <field name="name">markket.store.url.form</field>
        <field name="model">markket.store.url</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="store_id"/>
                        <field name="sequence"/>
                        <field name="label"/>
                        <field name="url"/>
                        <field name="markket_url_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_markket_store_url" model="ir.actions.act_window">
        <field name="name">Store URLs</field>
        <field name="res_model">markket.store.url</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_markket_store_url" name="Store URLs" parent="menu_markket_root" action="action_markket_store_url" sequence="25" groups="markket.group_markket_manager"/>
</odoo>
