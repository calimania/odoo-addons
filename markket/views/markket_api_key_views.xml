<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_markket_api_key_list" model="ir.ui.view">
        <field name="name">markket.api.key.list</field>
        <field name="model">markket.api.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="owner_user_id"/>
                <field name="masked_key" string="API Key"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_markket_api_key_form" model="ir.ui.view">
        <field name="name">markket.api.key.form</field>
        <field name="model">markket.api.key</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="owner_user_id"/>
                        <field name="active"/>
                        <field name="api_key" password="True"/>
                        <field name="masked_key" readonly="1"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_markket_api_key" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">markket.api.key</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_markket_api_key" name="API Keys" parent="menu_markket_root" action="action_markket_api_key" sequence="30" groups="markket.group_markket_manager"/>
</odoo>
