<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_markket_store_list" model="ir.ui.view">
        <field name="name">markket.store.list</field>
        <field name="model">markket.store</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="store_slug"/>
                <field name="owner_user_id"/>
                <field name="markket_id"/>
                <field name="active"/>
                <field name="last_sync_status"/>
                <field name="last_sync_at"/>
            </list>
        </field>
    </record>

    <record id="view_markket_store_form" model="ir.ui.view">
        <field name="name">markket.store.form</field>
        <field name="model">markket.store</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_from_public_api" type="object" string="Sync Public API" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="store_slug"/>
                            <field name="owner_user_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="markket_id" readonly="1"/>
                            <field name="markket_document_id" readonly="1"/>
                            <field name="locale" readonly="1"/>
                            <field name="stripe_customer_id" readonly="1"/>
                            <field name="uuid" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group>
                        <group>
                            <field name="markket_created_at" readonly="1"/>
                            <field name="markket_updated_at" readonly="1"/>
                            <field name="published_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_sync_at" readonly="1"/>
                            <field name="last_sync_status" readonly="1"/>
                            <field name="last_sync_message" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="raw_payload" readonly="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_markket_store_search" model="ir.ui.view">
        <field name="name">markket.store.search</field>
        <field name="model">markket.store</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="store_slug"/>
                <field name="owner_user_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_markket_store" model="ir.actions.act_window">
        <field name="name">Stores</field>
        <field name="res_model">markket.store</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_markket_store_search"/>
    </record>

    <menuitem id="menu_markket_root" name="Markket" sequence="10" groups="markket.group_markket_user"/>
    <menuitem id="menu_markket_store" name="Stores" parent="menu_markket_root" action="action_markket_store" sequence="20" groups="markket.group_markket_user"/>
</odoo>
