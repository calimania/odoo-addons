<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sendgrid_inbound" model="ir.module.category">
        <field name="name">SendGrid Inbound</field>
        <field name="description">Webhook and inbound email handling</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_sendgrid_inbound_viewer" model="res.groups">
        <field name="name">SendGrid Inbound Viewer</field>
        <field name="comment">Puede ver registros de entradas SendGrid</field>
    </record>

    <!-- Permitir que los miembros del grupo vean mensajes de correo entrantes -->
    <record id="rule_sendgrid_mail_message_read" model="ir.rule">
        <field name="name">Mail Messages - SendGrid viewer</field>
        <field name="model_id" ref="mail.model_mail_message"/>
        <field name="groups" eval="[(4, ref('sendgrid_inbound.group_sendgrid_inbound_viewer'))]"/>
        <field name="domain_force">[("message_type", "=", "email")]</field>
        <field name="perm_read" eval="True"/>
    </record>

    <!-- Permitir ver adjuntos ligados al log inbound -->
    <record id="rule_sendgrid_attachment_read" model="ir.rule">
        <field name="name">Attachments - SendGrid inbound log</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="groups" eval="[(4, ref('sendgrid_inbound.group_sendgrid_inbound_viewer'))]"/>
        <field name="domain_force">[("res_model", "=", "sendgrid.inbound.log")]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="global" eval="False"/>
        <field name="active" eval="False"/>
    </record>
</odoo>
